# RailSaathi Production Environment Variables
# Server-side only - NEVER commit secrets or put in client code!

RAILRADAR_API_KEY=your_railradar_api_key_here
DATABASE_URL=postgresql://postgres:password@your-db-host:5432/railsaathi?sslmode=require
SESSION_SECRET=super_secure_random_session_secret_32_chars_min
NODE_ENV=production
